<PageLayout meta={{ title: "Home" }}>
			<h1 class="title mb-12">Welcome!</h1>

  <div class="mb-8 flex flex-col items-center gap-6 sm:flex-row sm:items-center">
    <Image
      src={profilePhoto}
      alt="Nishant Tatar"
      class="h-40 w-40 rounded-full object-cover shadow-md"
      width={2000}
      height={2000}
    />


    <!-- Info List -->
    <ul class="flex flex-col gap-2">
      {info.map(({ icon, label, link }) => (
        <li class="flex items-center gap-2">
          <Icon name={icon} class="h-5 w-5 shrink-0 text-icon" />
          {link
            ? <a href={link} class="hover:text-link" target="_blank" rel="noreferrer">{label}</a>
            : <span>{label}</span>
          }
        </li>
      ))}
    </ul>
  </div>

