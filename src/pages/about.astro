---
import PageLayout from "@/layouts/Base.astro";

const meta = {
  description: "A little bit about me, my interests, and this website.",
  title: "About",
  ogImage: "/og-image/about.png",
};

---

<PageLayout meta={meta}>

  <div class="prose prose-sm prose-cactus max-w-none">
    <p>
      Hi, I'm Nishant Tatar. This is my personal website. I hope to update this (semi?)regularly, and add some information about myself here in the process. Will I be sucessful? Time shall tell.
    </p>
    <p>A few things off the top off my head about myself:</p>
    <ul class="list-inside list-disc" role="list">
      <li>I did my Bachelors in Technology from IIT Gandhinagar.</li>
      <li>I majored in Materials Engineering, with a minors in Computer Science.</li>
      <li>I love exploring about random niche topics to satiate my curiosity.</li>
      <li>I like tinkering around with stuff.</li>
      <li>I've been using Linux for the past few years. It started out due to a very bad laptop that couldn't run windows, and now I hate windows.</li>
    </ul>
  </div>
</PageLayout>
