---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "The page you are looking for does not exist.",
	title: "Page Not Found",
	  ogImage: "/og-image/404.png",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">This is an invalid page. Did you enter the correct URL?</h1>
	<p class="mb-8">Please use the <a href="/sitemap/" class="cactus-link">sitemap</a> to find your way back</p>
</PageLayout>
